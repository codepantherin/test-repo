# Server
PORT=4000
NODE_ENV=development

# CORS — the origin(s) allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# SMTP credentials (e.g. Resend, SendGrid, Mailgun, Postmark)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Mail envelope
MAIL_FROM="Portfolio <no-reply@example.com>"
MAIL_TO=you@example.com
