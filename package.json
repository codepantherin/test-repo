{
  "name": "harwinder-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Professional portfolio for Harwinder — Full Stack Web Developer. Built with HTML, Tailwind CSS and vanilla JS.",
  "type": "module",
  "scripts": {
    "dev": "tailwindcss -i ./src/input.css -o ./dist/styles.css --watch",
    "build": "tailwindcss -i ./src/input.css -o ./dist/styles.css --minify",
    "serve": "npx --yes serve . -l 3000",
    "start": "npm run dev"
  },
  "keywords": [
    "portfolio",
    "tailwindcss",
    "vanilla-js",
    "full-stack",
    "web-developer"
  ],
  "author": "Harwinder",
  "license": "MIT",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "> 0.5%",
    "not dead"
  ],
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
